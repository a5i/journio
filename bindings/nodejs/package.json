{
  "name": "@journio/sdk",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "native/*.node",
    "native/index.js"
  ],
  "scripts": {
    "build:native": "napi build --cargo-cwd native --release native",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5",
    "vitest": "^1.4.0"
  }
}
